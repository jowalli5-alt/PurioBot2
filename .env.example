# ====== Telegram Bot ======
# Токен бота, полученный у @BotFather
BOT_TOKEN=

# Юзернейм бота без @ (например purio_vpn_bot). Можно оставить пустым.
BOT_USERNAME=

# Канал, обязательный для подписки
CHANNEL_USERNAME=@PurioVPN
CHANNEL_LINK=https://t.me/PurioVPN

# Юзернейм поддержки
SUPPORT_USERNAME=@PurioSupport

# Ссылки на политику конфиденциальности и пользовательское соглашение
# (кнопки появятся в разделе "Поддержка"). Можно оставить пустыми —
# тогда бот покажет запасной текст-заглушку.
PRIVACY_POLICY_URL=
TERMS_OF_USE_URL=

# ====== Remnawave ======
# Адрес твоей панели БЕЗ слэша и БЕЗ /api на конце, например https://panel.purio.space
REMNAWAVE_BASE_URL=
# Токен из Remnawave: Settings -> API Tokens
REMNAWAVE_API_TOKEN=
# UUID сквада (группы нод), в который добавлять пользователей
REMNAWAVE_SQUAD_UUID=

# ====== Platega (платежи) ======
# MerchantId и API-ключ из личного кабинета Platega (Настройки),
# либо выданные вам менеджером при подключении
PLATEGA_MERCHANT_ID=
PLATEGA_SECRET=
PLATEGA_RETURN_URL=https://t.me/PurioVPN

# ====== Telegram Stars (оплата звёздами) ======
# Работает без отдельного подключения — Telegram сам обрабатывает такие платежи.
# Курс: сколько звёзд стоит 1 рубль пополнения. По умолчанию 0.5 (1 звезда = 2₽).
STARS_PER_RUB=0.5

# ====== Прочее ======
# Файл БД лежит в подпапке data/ (добавлена в .gitignore), чтобы при
# обновлении бота из GitHub (`git pull`) она никогда не затиралась.
DB_PATH=data/bot.db
